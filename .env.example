# Core Django
SECRET_KEY=replace-with-a-long-random-production-secret
DEBUG=True
USE_SQLITE=True
ALLOWED_HOSTS=localhost,127.0.0.1,mrnilam.org.np,www.mrnilam.org.np,.onrender.com
CSRF_TRUSTED_ORIGINS=https://mrnilam.org.np,https://www.mrnilam.org.np
