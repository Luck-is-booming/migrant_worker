# Core Django
SECRET_KEY=replace-with-a-long-random-production-secret
DEBUG=True
USE_SQLITE=True
ALLOWED_HOSTS=localhost,127.0.0.1,mrnilam.org.np,www.mrnilam.org.np,.onrender.com
CSRF_TRUSTED_ORIGINS=https://mrnilam.org.np,https://www.mrnilam.org.np
SITE_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO

# Production PostgreSQL. Leave blank locally when USE_SQLITE=True.
DATABASE_URL=
# Optional: a disposable PostgreSQL database used only for the concurrency test.
TEST_DATABASE_URL=

# Public uploads in production. Never rely on Render's temporary local disk.
# Credentials must permit create/read/delete for public assets and authenticated
# counseling/payment assets. Verify with a controlled upload before launch.
CLOUDINARY_URL=

# Email. Keep disabled until the Resend sender/domain is verified.
EMAIL_NOTIFICATIONS_ENABLED=False
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=MRN Ilam <notifications@mrnilam.org.np>
ADMIN_NOTIFICATION_EMAIL=

# Safe administrator bootstrap for Render
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
RESET_ADMIN_PASSWORD=False

# Official membership payment details are managed in Django Admin under
# Core > Membership payment settings. These values are legacy test fallbacks
# and must not be treated as published fees.
GENERAL_MEMBER_AMOUNT=0
LIFE_MEMBER_AMOUNT=0
MEMBERSHIP_PAYMENT_PURPOSE=MRN Ilam organization membership fee

# Counseling privacy and abuse prevention
COUNSELING_ATTACHMENTS_ENABLED=False
COUNSELING_RATE_LIMIT_PER_HOUR=5
PRIVACY_RETENTION_PERIOD=12 months after case closure unless a legal or audit obligation requires longer retention

# Enable only after HTTPS is stable on every required subdomain.
HSTS_ENABLED=False
