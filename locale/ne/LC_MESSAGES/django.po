# Added during counseling-first production refactor
#: templates/core/guidance.html:6
msgid "Before considering foreign employment"
msgstr "वैदेशिक रोजगार सोच्नुअघि"

#: templates/core/guidance.html:6
msgid "Clarify your goal, skills, health, family responsibilities, expected costs, and acceptable risks."
